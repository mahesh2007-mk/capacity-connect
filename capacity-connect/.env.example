# Frontend Configuration
# In local development or Vercel serverless with rewrites, leave empty to use relative /api paths.
# If deploying frontend separately from backend, specify full base URL (e.g., https://your-backend.vercel.app)
VITE_API_BASE_URL=

# Backend Secrets (NEVER expose to frontend, never prefix with VITE_)
JWT_SECRET=super_secure_capacity_connect_production_secret_key_2026
GEMINI_API_KEY=
DATABASE_PATH=capacity_connect.db
